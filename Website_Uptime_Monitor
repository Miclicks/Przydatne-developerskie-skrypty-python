import requests
import time
from datetime import datetime

# List of websites to monitor
WEBSITES = [
    'https://www.google.com',
    'https://www.github.com',
    'https://www.python.org',
    'https://this-site-does-not-exist-test.com' # Intentionally broken URL for testing
]

def check_status():
    """
    Iterates through the list and checks status code.
    """
    print(f"--- Uptime Report: {datetime.now().strftime('%H:%M:%S')} ---")
    
    for site in WEBSITES:
        try:
            # Send a request with a 5-second timeout
            response = requests.get(site, timeout=5)
            
            # Check if the status code indicates success (200)
            if response.status_code == 200:
                print(f"[OK] {site} is online.")
            else:
                print(f"[WARN] {site} returned code: {response.status_code}")
                
        except requests.exceptions.ConnectionError:
            print(f"[DOWN] {site} is unreachable!")
        except Exception as e:
            print(f"[ERROR] {site}: {e}")
            
    print("-" * 40)

if __name__ == "__main__":
    check_status()
