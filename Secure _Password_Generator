import secrets
import string

def generate_password(length=16, use_symbols=True):
    """
    Generates a secure password string.
    """
    # Define character pool: A-Z, a-z, 0-9
    alphabet = string.ascii_letters + string.digits
    
    if use_symbols:
        alphabet += string.punctuation  # Adds !@#$%^&* etc.

    # secrets.choice is safer than random.choice
    password = ''.join(secrets.choice(alphabet) for _ in range(length))
    return password

def main():
    print("--- Secure Password Generator ---")
    try:
        # Get user input with default fallbacks
        length_input = input("Enter password length (default 16): ")
        length = int(length_input) if length_input else 16
        
        count_input = input("How many passwords? (default 1): ")
        count = int(count_input) if count_input else 1
        
        print("\nGenerated Passwords:")
        for _ in range(count):
            print(f">> {generate_password(length)}")
            
    except ValueError:
        print("Error: Please enter a valid number.")

if __name__ == "__main__":
    main()
