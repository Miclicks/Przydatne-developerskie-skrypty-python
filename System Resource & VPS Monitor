"""
SCRIPT: System Resource & VPS Monitor
DESCRIPTION:
    A lightweight utility to monitor system health. It retrieves current CPU usage,
    available RAM, and disk space. Perfect for quick checks on local machines or Linux VPS servers.

LEARNING CONCEPTS:
    1. System Administration: Interacting with OS-level hardware data.
    2. Third-Party Libraries: Utilizing 'psutil' for cross-platform system monitoring.
    3. Data Formatting: Converting bytes to Gigabytes for human-readable output.

USAGE:
    1. Install psutil: `pip install psutil`
    2. Run the script via terminal.
"""

import psutil
import platform

def get_size(bytes_size):
    """
    Converts bytes to a human-readable format (e.g., MB, GB).
    """
    factor = 1024
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if bytes_size < factor:
            return f"{bytes_size:.2f} {unit}"
        bytes_size /= factor

def system_status():
    print(f"--- SYSTEM MONITOR ({platform.system()} {platform.release()}) ---")
    
    # 1. CPU Info
    # Interval=1 means it calculates usage over 1 second for accuracy
    cpu_usage = psutil.cpu_percent(interval=1)
    cpu_cores = psutil.cpu_count(logical=True)
    print(f"[CPU] Usage: {cpu_usage}% (Cores: {cpu_cores})")
    
    # 2. Memory (RAM) Info
    ram = psutil.virtual_memory()
    total_ram = get_size(ram.total)
    used_ram = get_size(ram.used)
    print(f"[RAM] Used: {used_ram} / {total_ram} ({ram.percent}%)")
    
    # 3. Disk Info (Root directory '/')
    # Note: On Windows, you might want to check 'C:\\' instead of '/'
    path = '/' if platform.system() != 'Windows' else 'C:\\'
    disk = psutil.disk_usage(path)
    total_disk = get_size(disk.total)
    free_disk = get_size(disk.free)
    print(f"[DISK] Free Space on {path}: {free_disk} / {total_disk} ({100 - disk.percent}% free)")
    
    print("-" * 40)

if __name__ == "__main__":
    system_status()
